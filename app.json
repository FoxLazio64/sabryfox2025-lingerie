{
  "expo": {
    "name": "SabryFox2025 Lingerie",
    "slug": "sabryfox2025-lingerie",
    "version": "1.0.7",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.sabryfox2025.lingerie"
    },
    "android": {
      "package": "it.sabryfox2025.lingerie",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#160B12"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#160B12"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "eas": {
        "projectId": "d33598f0-2895-49ed-9be3-18cee391c3a2"
      }
    },
    "owner": "fox64"
  }
}
